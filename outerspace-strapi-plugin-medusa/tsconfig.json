{
  "extends": "@strapi/typescript-utils/tsconfigs/admin",

  "compilerOptions": {
    "outDir": "./dist/admin",
    "rootDir": ".",
    "baseUrl": ".",
    "jsx": "react",
    "allowJs": true,
    "declaration": true,
    "noEmit": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "composite": true
  },

  "include": [   
    "admin/**/*.tsx",
    "admin/**/*.ts",
    "admin/**/*.json",
    "custom.d.ts",
    "package.json"
  ],
  "exclude": [
    "node_modules/",
    "dist/",

    // Do not include server files in the server compilation
    "server/",
    // Do not include test files
    "**/*.test.ts"
  ]
}
